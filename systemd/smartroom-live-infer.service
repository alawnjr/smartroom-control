# Live inference service on the quad server: receives pushed frames from the Pi,
# runs pose + room localization + AVA actions + identity tracking, serves the
# viewer/API on :8010, and continuously records 3-minute segments into the
# recordings tree (empty ones auto-deleted).
#
# USER unit (no sudo), same pattern as smartroom-mirror.service. Install:
#   mkdir -p ~/.config/systemd/user
#   ln -sf ~/smartroom-control/systemd/smartroom-live-infer.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now smartroom-live-infer
#   loginctl enable-linger intern26      # survive logout / start at boot

[Unit]
Description=smartroom live inference (pose, actions, identities, segment recording)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/smartroom-control
# .venv-action has ultralytics + mmaction + mmdet together (NOT .venv-detect)
# The four camera_cam<N>_color entries are the Reolink NVR cameras, pushed in by
# CityOSNode/reolink_live_forward.py from the host that can reach the NVR (the
# quad server has no route to the camera network). They arrive as the NVR's SUB
# stream, 640x360 h264, deliberately: the recorder keeps the 4K main stream on
# disk, and four more 4K decodes here would land on top of the depth cameras'
# pose work. A camera with no uploaded clip carrying calibration+extrinsics is
# skipped at startup, so each of these needs one recording uploaded first.
# The D435 is DROPPED from the live pipeline (2026-08-03, at the user's request).
# It was never worth its trouble here: the Pi's 60-frameset queue gives it a delay
# that follows the load rather than a constant (228ms to 2.7s within a day), its
# auto-exposure leaves a 48-level brightness swing that the timing calibration cannot
# get a reliable reading from, its depth over-reads by 7% pending Intel's on-chip
# self-calibration, and it sees its tags too head-on to calibrate its pose well. The
# D455 carries the depth work alone. To bring it back, add camera_d435_color here and
# to SMARTROOM_HW_CLOCK_CAMS below.
ExecStart=%h/smartroom-control/.venv-action/bin/python detect/live_infer.py \
    --cam camera_d455_color,camera_cam1_color,camera_cam2_color,camera_cam3_color,camera_cam4_color \
    --port 8010 --action ava
Environment=SMARTROOM_SAVE_DIR=/mnt/data4/intern26/recordings
# ONLY these cameras publish room positions; every other camera streams, poses and
# records but contributes no location. The D455 is the single source of truth for
# spatial data at the user's request (2026-07-30), until they say otherwise.
#
# An allowlist rather than a list of muted cameras, deliberately: the four NVR
# cameras joined this pipeline without anyone deciding they should localize, and
# with a denylist a fifth would do the same silently. Add a camera here only after
# its positions have actually been checked.
#
# What is being left out, and why it is not a loss of known-good data:
#   - D435: sits close enough that a person fills its frame, so it has no confident
#     hip and falls back to the shoulder anchor, whose depth reads the wall behind
#     them — it placed a person at 1424mm where the D455 put them at 383mm.
#   - cam1-4: localize by ankle floor-ray from 2.6m. The mechanism is verified but
#     its accuracy never was, and ray positions are looser than depth ones — at the
#     600mm GEO_MERGE_MM they risk splitting one person into two.
Environment=SMARTROOM_SPATIAL_ONLY=camera_d455_color
# The D455 sends librealsense global time — a real per-frame capture instant — so use
# it directly rather than a constant offset. Stated rather than measured because being
# in its own clock domain is a fact about the hardware, not something a light switch
# needs to establish, and it makes the D455 the reference every other camera is
# measured against.
Environment=SMARTROOM_HW_CLOCK_CAMS=camera_d455_color
# Segment length for the ALWAYS-ON mode only, which is off — a take someone started
# is one clip however long it runs. Dead config unless SMARTROOM_SEGMENT_ALWAYS=1.
Environment=SMARTROOM_SEGMENT_S=180
# 0 = keep every camera's clip. The old 15 meant a clip was thrown away unless 15 of
# its frames contained a localized person, which made whole cameras disappear from a
# take: cam1 localizes nobody at all, and an empty-room take left no folder behind at
# all. Recording is on demand now — pressing Record IS the decision that the footage
# is wanted, and a second filter behind it only loses data. Costs GPU time in the
# analysis pass and rows in the recordings list, not meaningful disk (~10 MB/min for
# all five cameras).
Environment=SMARTROOM_SEGMENT_MIN_FRAMES=0
# Stop the CPU thread pools busy-waiting. ONNX Runtime (the ReID encoder, which
# falls back to CPU here) and OpenMP both default to one worker per core — 36 on
# this box — and both SPIN rather than sleep between batches. Measured: ~7
# threads pinned near 74% each and 1724% total process CPU, ~17 of 36 cores, to
# do 2x30fps of nano-model pose. The work itself is small-batch and single-image,
# so wide pools buy nothing and only add scheduling noise on a shared machine.
#
# Note the deliberate choice NOT to fix this by installing onnxruntime-gpu: that
# would load a THIRD compiled CUDA runtime into the pose process alongside
# ultralytics/torchvision, which is the exact hazard that took this service down
# (see the AVA worker split in detect/live_infer.py). CPU cycles are cheap here;
# CUDA context corruption is not.
Environment=OMP_NUM_THREADS=4
Environment=OMP_WAIT_POLICY=PASSIVE
Environment=MKL_NUM_THREADS=4
# ...and stop ultralytics trying to pip-install onnxruntime-gpu on every start.
# It cannot succeed (this venv has no pip) and it burns ~20s of startup in
# retries before falling back to CPU anyway.
Environment=YOLO_AUTOINSTALL=false
Restart=always
RestartSec=10
# Model loading (two SlowFast + two pose + two ReID) takes a while; do not let
# systemd consider a slow start a failure.
TimeoutStartSec=300
StandardOutput=append:/tmp/live_infer.log
StandardError=inherit

[Install]
WantedBy=default.target
