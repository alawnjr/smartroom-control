# smartroom-analyze.service — run the full analysis pass over the recordings
# store, in place, on the quad server (ortiz-lambda-quad). Fired by
# smartroom-analyze.path when new recordings land. Oneshot; the pipeline is
# idempotent (skips fresh clips) so overlapping fires are safe.
#
# Install (on the server, as intern26 — user units so no root needed):
#   mkdir -p ~/.config/systemd/user
#   ln -sf ~/smartroom-control/systemd/smartroom-analyze.service ~/.config/systemd/user/
#   ln -sf ~/smartroom-control/systemd/smartroom-analyze.path    ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now smartroom-analyze.path
#   loginctl enable-linger intern26     # keep it running without an active login
[Unit]
Description=Run smartroom GPU analysis over new recordings (in place)

[Service]
Type=oneshot
# CODE lives in /home/intern26; DATA (recordings) live on /mnt/data4. Keep the
# two separate per the server's storage rules.
Environment=SMARTROOM_REMOTE_DIR=%h/smartroom-control
Environment=SMARTROOM_SAVE_DIR=/mnt/data4/intern26/recordings
# Skip burned-in annotated videos: they cost ~75% of analysis wall-clock (per-
# frame draw + encode) and the 3D view / API run on the JSON sidecars, not the
# overlay videos. The 2D player just shows raw video for the overlay tabs. Set
# to 1 (or remove) if you want browser-playable boxes-burned-in videos back —
# the encode now uses the GPU (NVENC), so it's much cheaper than before.
Environment=SMARTROOM_DETECT_ANNOTATE=0
# TWO action models per clip, and they see different things:
#   ava  — SlowFast-AVA, RGB pixels + each person's box: carried objects, posture,
#          scene context, multi-label. The same model the live service runs.
#   hmdb — PoseC3D on HMDB51, KEYPOINTS only: blind to objects and appearance, but
#          it reads gait, so it separates walk/run/turn from stand/sit, which AVA
#          conflates. Skeleton-only also means it survives lighting changes.
# Each writes its own sidecar set (action-ava / action-hmdb); the dashboard's
# "Action model" buttons switch which one drives the labels. Neither overwrites
# the other, and dropping one from this list just stops refreshing it.
# HMDB51's vocabulary is sports/consumer video, so on office footage its rare
# classes ("dribble", "draw sword") are what an out-of-distribution argmax looks
# like — temperature + abstention already suppress the weak ones, and
# action-classes.json can mask any class outright (see detect/action.py).
# Cost: PoseC3D is a 3D-CNN — budget ~1.5 min per 30 s clip on one GPU, sharded
# across all of them by run-analysis.sh.
Environment=SMARTROOM_ACTION_VARIANTS=ava,hmdb
# Spatial estimation comes from the DEPTH camera, full stop — same allowlist the
# live service runs under. Without it, localize.py falls back to the ankle
# floor-ray on any clip with no depth track, i.e. it would guess room positions
# from Reolink footage. Nothing on disk has one today, but only because
# live_infer had already written a `live` sidecar the offline pass refuses to
# overwrite — an ordering accident, not a rule. This is the rule.
Environment=SMARTROOM_SPATIAL_ONLY=camera_d455_color
WorkingDirectory=%h/smartroom-control
ExecStart=%h/smartroom-control/run-analysis.sh
# The runner exits nonzero if some clip/model failed; don't spam failed-state.
SuccessExitStatus=0 1
